{
  "manifest_version": 3,
  "name": "Colab Clicker",
  "version": "1.0",
  "short_name": "Colab Clicker",
  "description": "Faz tentativas periódicas de atividade em uma aba autorizada do Google Colab.",
  "permissions": [
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://colab.research.google.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Abrir Colab Clicker"
  },
  "background": {
    "service_worker": "background.js"
  }
}
